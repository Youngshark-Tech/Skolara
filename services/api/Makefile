.PHONY: build run test test-integration vet fmt migrate-up migrate-down

build: ; go build ./...
run: ; go run ./cmd/api
vet: ; go vet ./...
fmt: ; gofmt -l -w .
test: ; go test -race ./...
test-integration: ; TEST_DATABASE_URL="$${TEST_DATABASE_URL}" go test -race -tags=integration ./...
migrate-up: ; go run ./cmd/migrate up
migrate-down: ; go run ./cmd/migrate down
