# Skolara API — copy to .env (never commit .env)
SKOLARA_ENV=development
SKOLARA_HTTP_ADDR=:8080
DATABASE_URL=postgres://skolara:skolara_dev@localhost:5432/skolara?sslmode=disable
# Reserved for shared rate limiting — ROADMAP (unused by the API today)
SKOLARA_REDIS_ADDR=127.0.0.1:6379
# >= 32 bytes; MUST be changed for production
SKOLARA_JWT_SECRET=dev-only-secret-change-me-32-bytes-min
# HMAC key for the payments webhook; >= 32 bytes REQUIRED in production
# (the API refuses to boot without it there). Value below is dev-only and
# matches what scripts/e2e-smoke.sh signs with.
SKOLARA_WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef
# Initial platform admin, created on first boot when the users table is
# empty (leave SKOLARA_BOOTSTRAP_ADMIN_EMAIL empty to skip bootstrap).
SKOLARA_BOOTSTRAP_ADMIN_EMAIL=admin@skolara.test
# Dev-only bootstrap password (min 8 chars) — MUST be changed for anything
# beyond local development.
SKOLARA_BOOTSTRAP_ADMIN_PASSWORD=S0pera!Admin2026
SKOLARA_CORS_ORIGINS=http://localhost:3000
SKOLARA_LOG_LEVEL=info
SKOLARA_LOG_FORMAT=json
