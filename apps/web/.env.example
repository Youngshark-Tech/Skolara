# Skolara web app environment (apps/web)
# Copy to .env.local for local development; set as build args/env in deployment.

# Base URL of the Skolara API (no trailing slash).
# IMPORTANT: NEXT_PUBLIC_* variables are inlined into the client bundle at
# BUILD time. The Docker build FAILS if this is unset (apps/web/Dockerfile) —
# otherwise the bundle would be hardwired to the localhost dev default (#56).
# Examples:
#   local dev:    http://localhost:8080
#   production:   https://api.school.example
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Cross-origin session cookies (read before deploying web and API on different
# sites):
#
# The API authenticates sessions with an HttpOnly refresh cookie
# (`skolara_refresh`, Path=/api/v1/auth) and the web keeps the short-lived
# access token in memory only (ADR-011). Cookies are scoped per SITE, so:
#
# - web and API on the SAME SITE (e.g. app.school.example and
#   api.school.example, or localhost:3000 + localhost:8080 in dev): the API's
#   default SameSite=Lax cookie works — keep HTTPS so the cookie is also set
#   with Secure (SKOLARA_SECURE_COOKIES on the API).
# - web and API on DIFFERENT SITES (e.g. *.vercel.app app + separate API
#   domain): browsers will NOT send a Lax cookie on cross-site requests and
#   silent refresh will fail. Either deploy behind a shared parent site, or the
#   API must emit the refresh cookie with `SameSite=None; Secure` (an API-side
#   configuration change — do NOT drop Secure in production).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Full demo data mode (issue #142) — TEMPORARY, demos only.
#
# NEXT_PUBLIC_DEMO_MODE=true answers EVERY API call from an in-memory mock
# transport (src/lib/mock) that mirrors the real API contract: the app runs
# with NO database, NO API service, and NO network. Sessions never expire and
# any credentials sign in. Implies NEXT_PUBLIC_AUTH_BYPASS (issue #141).
#
#   NEXT_PUBLIC_DEMO_MODE=true
#
# Sample data resets on every full page load (deliberate — demos always start
# clean). A "Demo data — not live" badge is shown in the sidebar so mock
# figures are never mistaken for live ones.
#
# SECURITY: NEVER enable on a deployment holding real student, guardian, or
# financial data. NEXT_PUBLIC_* values are inlined at BUILD time — toggling
# the flag on Vercel requires a redeploy. Production switch: unset the flag,
# set DATABASE_URL on the API, redeploy — migrations and schemas are already
# in place (services/api/migrations, CI-verified). See docs/operations/DEMO.md.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Open-access mode (issue #141) — TEMPORARY, demo/staging only.
#
# NEXT_PUBLIC_AUTH_BYPASS=true disables the login surface: visitors are signed
# in automatically as the seeded demo admin (a REAL session — RBAC, tenant
# scoping, and audit keep working). Pair it with SKOLARA_DEMO_SEED=true on the
# API so the demo accounts exist.
#
#   NEXT_PUBLIC_AUTH_BYPASS=true
#   NEXT_PUBLIC_BYPASS_EMAIL=admin@skolara.dev        # optional override
#   NEXT_PUBLIC_BYPASS_PASSWORD=SkolaraDemo!2026      # optional override —
#       # must match SKOLARA_DEMO_PASSWORD if the API seeded custom passwords
#
# SECURITY: NEVER enable on a deployment holding real student, guardian, or
# financial data — it hands every visitor a working admin session.
# NEXT_PUBLIC_* values are inlined at BUILD time: on Vercel, toggling the flag
# requires a redeploy. See docs/operations/DEMO.md.
# ---------------------------------------------------------------------------
