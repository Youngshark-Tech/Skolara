# Skolara local stack — copy to .env and adjust
POSTGRES_USER=skolara
POSTGRES_PASSWORD=skolara_dev
POSTGRES_DB=skolara
# MUST be changed for anything beyond local development (min 32 bytes)
SKOLARA_JWT_SECRET=dev-only-secret-change-me-32-bytes-min
# HMAC key for the payments webhook (production requires >= 32 bytes).
# The value below is dev-only and matches what scripts/e2e-smoke.sh signs with.
SKOLARA_WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef
# Initial platform admin, created on first boot when the users table is empty.
SKOLARA_BOOTSTRAP_ADMIN_EMAIL=admin@skolara.test
# Dev-only bootstrap password (min 8 chars) — MUST be changed for anything
# beyond local development.
SKOLARA_BOOTSTRAP_ADMIN_PASSWORD=S0pera!Admin2026
# Base URL the web app uses to reach the API. Baked into the web image at
# build time (NEXT_PUBLIC_*), so set it before `docker compose build`.
NEXT_PUBLIC_API_URL=http://localhost:8080
